---
interface LinkCard {
  title: string;
  description: string;
  url?: string;
}
interface Props {
  heading: string;
  subheading?: string;
  intro: string;
  accentColor?: string;
  linkCards?: LinkCard[];
}
const { heading, subheading, intro, accentColor = 'teal', linkCards = [] } = Astro.props;
---

<div class="pt-14">
  <section class="bg-navy text-cream py-20 text-center px-4">
    {subheading && <p class="text-gold tracking-[0.3em] uppercase text-xs font-sans mb-3">{subheading}</p>}
    <h1 class="font-serif text-5xl md:text-6xl text-cream mb-4">{heading}</h1>
    <div class="vintage-divider max-w-xs mx-auto">
      <span class="text-gold">✦</span>
    </div>
    <p class="font-sans text-cream/70 max-w-2xl mx-auto">{intro}</p>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <slot />

    {linkCards.length > 0 && (
      <div class="grid sm:grid-cols-2 gap-6 mt-12">
        {linkCards.map(card => (
          <div class="border-2 border-navy/10 p-6 hover:border-teal transition-colors">
            <h3 class="font-serif text-xl text-navy mb-2">{card.title}</h3>
            <p class="font-sans text-navy/70 text-sm leading-relaxed mb-4">{card.description}</p>
            {card.url && (
              <a href={card.url} target="_blank" rel="noopener noreferrer"
                class="text-teal text-sm font-sans hover:text-coral transition-colors tracking-wide">
                Visit website →
              </a>
            )}
          </div>
        ))}
      </div>
    )}
  </section>
</div>

<style>
  .vintage-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem auto;
  }
  .vintage-divider::before,
  .vintage-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #C9A84C;
    opacity: 0.5;
  }
</style>
