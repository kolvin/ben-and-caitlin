---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Ben & Caitlin — Bermuda, June 2027', description = 'Join us to celebrate the wedding of Ben & Caitlin at The Reefs, Bermuda on Saturday 5 June 2027.' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/flights', label: 'Flights' },
  { href: '/accommodation', label: 'Accommodation' },
  { href: '/things-to-do', label: 'Things To Do' },
  { href: '/transport', label: 'Transport' },
  { href: '/food-and-drink', label: 'Food & Drink' },
  { href: '/rsvp', label: 'RSVP' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cream text-navy font-sans">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-navy/95 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4">
        <!-- Mobile: logo row + hamburger -->
        <div class="flex items-center justify-between h-14 md:hidden">
          <a href="/" class="font-serif text-cream text-lg italic">Ben & Caitlin</a>
          <button id="mobile-menu-btn" class="text-cream p-2" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
        <!-- Desktop nav -->
        <div class="hidden md:flex items-center justify-center gap-6 h-14">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`nav-link ${currentPath === link.href ? 'text-gold' : ''}`}
            >
              {link.label}
            </a>
          ))}
        </div>
        <!-- Mobile dropdown -->
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-cream/10">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`block py-2 px-2 nav-link ${currentPath === link.href ? 'text-gold' : ''}`}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-navy text-cream/70 text-center py-10 px-4">
      <p class="font-serif italic text-xl text-cream mb-2">Ben & Caitlin</p>
      <p class="text-sm tracking-widest uppercase text-gold mb-4">5 June 2027 · The Reefs, Bermuda</p>
      <p class="text-xs">Made with love ♡</p>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
