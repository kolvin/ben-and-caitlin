---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  navLight?: boolean;
}
const {
  title = 'Ben & Caitlin — Bermuda, June 2027',
  description = 'Join us to celebrate the wedding of Ben & Caitlin at The Reefs, Bermuda on Saturday 5 June 2027.',
  navLight = false,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/flights', label: 'Flights' },
  { href: '/accommodation', label: 'Accommodation' },
  { href: '/things-to-do', label: 'Guide' },
  { href: '/transport', label: 'Transport' },
  { href: '/food-and-drink', label: 'Food & Drink' },
  { href: '/rsvp', label: 'RSVP' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-parchment text-navy font-sans">

    <!-- Navigation -->
    <nav class={`fixed top-0 left-0 right-0 z-50 bg-parchment/95 backdrop-blur-sm border-b border-navy/10`}>
      <div class="max-w-7xl mx-auto px-6 md:px-10">
        <div class="flex items-center justify-between h-12">
          <!-- Logo -->
          <a href="/" class="font-sans text-xs tracking-[0.25em] uppercase text-navy hover:opacity-60 transition-opacity">
            Ben &amp; Caitlin
          </a>

          <!-- Desktop links -->
          <div class="hidden md:flex items-center gap-6">
            {navLinks.map(link => (
              <a
                href={link.href}
                class={`nav-link ${currentPath === link.href ? 'opacity-100 underline underline-offset-4 decoration-gold/60' : ''}`}
              >
                {link.label}
              </a>
            ))}
          </div>

          <!-- Mobile hamburger -->
          <button id="mobile-menu-btn" class="md:hidden p-2 text-navy" aria-label="Toggle menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <!-- Mobile dropdown -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-navy/10 py-4 bg-parchment/98">
          {navLinks.map(link => (
            <a href={link.href} class="block py-2 nav-link text-center">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-navy text-parchment/60 text-center py-12 px-4">
      <p class="font-script text-3xl text-parchment mb-2">Ben & Caitlin</p>
      <p class="text-xs tracking-[0.3em] uppercase text-gold/80 mb-4">5 June 2027 · The Reefs, Bermuda</p>
      <p class="text-xs opacity-40">Made with love ♡</p>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
