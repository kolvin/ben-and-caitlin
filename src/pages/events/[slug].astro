---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events, getEventBySlug } from '../../data/events';

export function getStaticPaths() {
  return events.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const currentIndex = events.findIndex(e => e.slug === event.slug);
const prevEvent = currentIndex > 0 ? events[currentIndex - 1] : null;
const nextEvent = currentIndex < events.length - 1 ? events[currentIndex + 1] : null;
---

<BaseLayout
  title={`${event.title} — Ben & Caitlin · Bermuda 2027`}
  description={event.description}
>
  <div class="pt-14">
    <!-- Event hero with poster -->
    <section class="bg-navy py-16 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Poster -->
          <div class="flex justify-center">
            <div class="shadow-2xl max-w-xs md:max-w-full">
              <img
                src={event.image}
                alt={event.title}
                class="w-full h-auto"
              />
            </div>
          </div>
          <!-- Details -->
          <div class="text-cream text-center md:text-left">
            <p class="text-gold tracking-[0.3em] uppercase text-xs font-sans mb-4">Wedding Week 2027</p>
            <h1 class="font-serif text-4xl md:text-5xl text-cream mb-4">{event.title}</h1>
            <div class="vintage-divider md:justify-start max-w-xs">
              <span class="text-gold">✦</span>
            </div>
            <div class="space-y-3 mb-8 font-sans">
              <div class="flex items-start gap-3">
                <span class="text-gold mt-1">📅</span>
                <div>
                  <p class="text-cream/50 text-xs uppercase tracking-widest">Date</p>
                  <p class="text-cream font-medium">{event.date}</p>
                </div>
              </div>
              {event.time !== 'TBC' && (
                <div class="flex items-start gap-3">
                  <span class="text-gold mt-1">🕐</span>
                  <div>
                    <p class="text-cream/50 text-xs uppercase tracking-widest">Time</p>
                    <p class="text-cream font-medium">{event.time}</p>
                  </div>
                </div>
              )}
              <div class="flex items-start gap-3">
                <span class="text-gold mt-1">📍</span>
                <div>
                  <p class="text-cream/50 text-xs uppercase tracking-widest">Venue</p>
                  <p class="text-cream font-medium">{event.venue}</p>
                  {event.address !== 'Bermuda' && (
                    <p class="text-cream/60 text-sm">{event.address}</p>
                  )}
                </div>
              </div>
            </div>
            <p class="font-sans text-cream/80 leading-relaxed mb-8">{event.description}</p>
            <a href={`/rsvp?event=${event.id}`} class="btn-primary">
              RSVP for This Event
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Carousel navigation -->
    <nav class="bg-navy/95 border-t border-cream/10 py-6 px-4">
      <div class="max-w-5xl mx-auto flex justify-between items-center gap-4">
        {prevEvent ? (
          <a href={`/events/${prevEvent.slug}`} class="group flex items-center gap-3 text-cream/70 hover:text-cream transition-colors">
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            <div class="text-left">
              <p class="text-xs text-cream/40 uppercase tracking-widest">Previous</p>
              <p class="font-serif text-sm">{prevEvent.title}</p>
            </div>
          </a>
        ) : <div />}

        <a href="/events" class="text-gold text-xs uppercase tracking-widest hover:text-cream transition-colors">
          All Events
        </a>

        {nextEvent ? (
          <a href={`/events/${nextEvent.slug}`} class="group flex items-center gap-3 text-cream/70 hover:text-cream transition-colors">
            <div class="text-right">
              <p class="text-xs text-cream/40 uppercase tracking-widest">Next</p>
              <p class="font-serif text-sm">{nextEvent.title}</p>
            </div>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ) : <div />}
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
  .vintage-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .vintage-divider::before,
  .vintage-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #C9A84C;
    opacity: 0.5;
  }
</style>
