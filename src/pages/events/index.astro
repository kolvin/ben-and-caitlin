---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events } from '../../data/events';
---

<BaseLayout title="Events — Ben & Caitlin · Bermuda 2027" description="All events for Ben & Caitlin's wedding week in Bermuda, June 2027.">
  <div class="pt-12">
    <!-- Header -->
    <section
      class="py-20 text-center px-4"
      style="background-image: url('/images/wall-only.png'); background-size: cover;"
    >
      <p class="font-sans text-navy/50 text-[0.6rem] tracking-[0.35em] uppercase mb-4">Bermuda · June 2027</p>
      <h1 class="font-script text-6xl md:text-7xl text-navy mb-2">The Events</h1>
      <div class="divider-gold max-w-[160px] mx-auto"></div>
      <p class="font-serif font-light text-navy/60 text-sm max-w-lg mx-auto">
        A full week of celebrations leading up to the big day. Click any event to find out more.
      </p>
    </section>

    <!-- Events grid -->
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-10">
        {events.map((event, i) => (
          <a
            href={`/events/${event.slug}`}
            class="group block relative"
            style={`transform: rotate(${[-1.2, 0.8, -0.5, 1.0, -0.7, 0.4][i % 6]}deg)`}
          >
            <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#8B7355] shadow-md z-10 before:content-[''] before:absolute before:inset-[3px] before:rounded-full before:bg-[#C4A882]"></div>
            <div class="shadow-[4px_8px_24px_rgba(0,0,0,0.2)] group-hover:shadow-[6px_12px_32px_rgba(0,0,0,0.32)] transition-all duration-300 group-hover:scale-[1.03] group-hover:-rotate-0">
              <img
                src={event.image}
                alt={event.title}
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
            <p class="text-center font-serif font-light text-xs text-navy/50 mt-3 tracking-wide">{event.title}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- RSVP CTA -->
    <section class="bg-navy py-14 text-center px-4">
      <p class="font-serif font-light text-parchment/60 text-sm mb-6">Ready to join us?</p>
      <a href="/rsvp" class="inline-block border border-parchment/40 text-parchment font-sans text-[0.65rem] px-8 py-3 tracking-[0.18em] uppercase hover:border-parchment hover:bg-parchment/10 transition-all duration-300">RSVP for All Events</a>
    </section>
  </div>
</BaseLayout>

<style>
  .divider-gold {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem auto;
  }
  .divider-gold::before,
  .divider-gold::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #A8874A;
    opacity: 0.4;
  }
</style>
