---
import BaseLayout from '../layouts/BaseLayout.astro';
import { events } from '../data/events';
---

<BaseLayout title="Ben & Caitlin — Bermuda, June 2027">
  <!-- Hero Section -->
  <section
    class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden"
    style="background-image: url('/images/room-background.png'); background-size: cover; background-position: center;"
  >
    <!-- Overlay for readability -->
    <div class="absolute inset-0 bg-navy/40"></div>

    <!-- Hero content -->
    <div class="relative z-10 px-4 py-20 pt-32">
      <!-- Decorative top line -->
      <p class="text-gold tracking-[0.4em] uppercase text-xs md:text-sm font-sans mb-6">You are cordially invited to celebrate</p>

      <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-cream mb-4 leading-tight">
        Ben &amp; Caitlin
      </h1>

      <div class="vintage-divider max-w-xs mx-auto">
        <span class="text-gold text-xl">✦</span>
      </div>

      <p class="font-serif italic text-2xl md:text-3xl text-cream/90 mb-2">
        Saturday 5<sup>th</sup> June 2027
      </p>
      <p class="font-sans text-cream/80 tracking-widest uppercase text-sm md:text-base mb-12">
        The Reefs · Bermuda
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/rsvp" class="btn-primary">
          RSVP Now
        </a>
        <a href="/events" class="inline-block border-2 border-cream text-cream font-serif text-lg px-8 py-3 hover:bg-cream hover:text-navy transition-all duration-300 tracking-wide">
          View Events
        </a>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-cream/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- Event Posters on the Wall -->
  <section class="relative py-20 overflow-hidden"
    style="background-image: url('/images/wall-only.png'); background-size: cover; background-position: center;">
    <div class="absolute inset-0 bg-cream/85"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4">
      <div class="text-center mb-14">
        <p class="text-gold tracking-[0.3em] uppercase text-xs font-sans mb-3">A week of celebrations</p>
        <h2 class="section-title">The Events</h2>
        <div class="vintage-divider max-w-sm mx-auto">
          <span class="text-gold text-lg">✦</span>
        </div>
        <p class="font-sans text-navy/70 max-w-lg mx-auto">
          From spa days to the big day — six events across a beautiful Bermuda week. Click any poster for full details.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
        {events.map((event) => (
          <a
            href={`/events/${event.slug}`}
            class="group relative block overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Poster image -->
            <img
              src={event.image}
              alt={event.title}
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-navy/0 group-hover:bg-navy/20 transition-all duration-300 flex items-end">
              <div class="w-full p-3 bg-navy/80 text-cream translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                <p class="font-serif text-sm font-semibold">{event.title}</p>
                <p class="text-xs text-cream/70">{event.date}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/events" class="btn-outline">
          View All Events
        </a>
      </div>
    </div>
  </section>

  <!-- The Location -->
  <section class="py-20 bg-navy text-cream">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-gold tracking-[0.3em] uppercase text-xs font-sans mb-3">Where we're getting married</p>
      <h2 class="font-serif text-4xl md:text-5xl text-cream mb-6">The Reefs, Bermuda</h2>
      <div class="vintage-divider max-w-xs mx-auto">
        <span class="text-gold">✦</span>
      </div>
      <p class="font-sans text-cream/80 max-w-2xl mx-auto mb-10 leading-relaxed">
        Perched on the cliffs above the turquoise waters of the South Shore, The Reefs is one of Bermuda's most romantic settings.
        Pink-sand beaches, ocean breezes, and a sky full of stars — the perfect place to start our forever.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/accommodation" class="inline-block border-2 border-gold text-gold font-serif text-lg px-8 py-3 hover:bg-gold hover:text-navy transition-all duration-300 tracking-wide">
          Where to Stay
        </a>
        <a href="/flights" class="inline-block border-2 border-cream/50 text-cream/80 font-serif text-lg px-8 py-3 hover:border-cream hover:text-cream transition-all duration-300 tracking-wide">
          Getting There
        </a>
      </div>
    </div>
  </section>

  <!-- RSVP CTA -->
  <section class="py-20 bg-cream text-center px-4">
    <p class="text-gold tracking-[0.3em] uppercase text-xs font-sans mb-3">Don't forget</p>
    <h2 class="section-title">Let us know you're coming</h2>
    <div class="vintage-divider max-w-xs mx-auto">
      <span class="text-gold">✦</span>
    </div>
    <p class="font-sans text-navy/70 max-w-lg mx-auto mb-8">
      Please RSVP by <strong>1 March 2027</strong> so we can plan the most wonderful week for you.
    </p>
    <a href="/rsvp" class="btn-primary">RSVP Now</a>
  </section>
</BaseLayout>

<style>
  .vintage-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem auto;
  }
  .vintage-divider::before,
  .vintage-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #C9A84C;
    opacity: 0.5;
  }
</style>
