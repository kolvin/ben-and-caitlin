---
import BaseLayout from '../layouts/BaseLayout.astro';
import { events } from '../data/events';
---

<BaseLayout title="RSVP — JBen & JCaitlin · Bermuda 2027">
  <div class="pt-12">
    <!-- Header -->
    <section
      class="py-20 text-center px-4"
      style="background-image: url('/images/wall-only.png'); background-size: cover;"
    >
      <p class="font-sans text-navy/50 text-[0.6rem] tracking-[0.35em] uppercase mb-4">Please reply by 1 March 2027</p>
      <h1 class="font-script text-6xl md:text-7xl text-navy mb-2">RSVP</h1>
      <div class="divider-gold max-w-[160px] mx-auto"></div>
      <p class="font-serif font-light text-navy/60 text-sm max-w-md mx-auto">
        We'd love to celebrate every moment with you. Let us know which events you can join us for.
      </p>
    </section>

    <!-- Form -->
    <section class="max-w-xl mx-auto px-6 py-16">
      <form
        name="rsvp"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="rsvp-form"
      >
        <input type="hidden" name="form-name" value="rsvp" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="space-y-8">
          <!-- Full Name -->
          <div>
            <label for="name" class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-2">
              Full Name <span class="text-coral">*</span>
            </label>
            <input type="text" id="name" name="name" required placeholder="Jane Smith"
              class="w-full border-b border-navy/20 bg-transparent text-navy font-serif font-light text-base pb-2 pt-1 focus:outline-none focus:border-navy/60 transition-colors placeholder:text-navy/20" />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-2">
              Email Address <span class="text-coral">*</span>
            </label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com"
              class="w-full border-b border-navy/20 bg-transparent text-navy font-serif font-light text-base pb-2 pt-1 focus:outline-none focus:border-navy/60 transition-colors placeholder:text-navy/20" />
          </div>

          <!-- Attending wedding -->
          <div>
            <label class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-3">
              Attending the wedding? <span class="text-coral">*</span>
            </label>
            <div class="flex gap-8">
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="radio" name="attending_wedding" value="yes" required class="accent-navy w-4 h-4" />
                <span class="font-serif font-light text-sm text-navy/80">Yes, I'll be there!</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="attending_wedding" value="no" class="accent-navy w-4 h-4" />
                <span class="font-serif font-light text-sm text-navy/80">Unable to attend</span>
              </label>
            </div>
          </div>

          <!-- Events -->
          <div>
            <label class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-1">Which events will you attend?</label>
            <p class="font-serif font-light text-navy/40 text-xs mb-4">Select all that apply</p>
            <div class="space-y-3">
              {events.filter(e => e.id !== 'wedding').map(event => (
                <label class="flex items-start gap-3 cursor-pointer group">
                  <input type="checkbox" name="events" value={event.id}
                    class="accent-navy w-4 h-4 mt-0.5 shrink-0" />
                  <span class="font-serif font-light text-sm text-navy/80 leading-snug">
                    {event.title}
                    <span class="text-navy/40 text-xs ml-1">— {event.date}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <!-- Dietary -->
          <div>
            <label for="dietary" class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-2">Dietary Requirements</label>
            <textarea id="dietary" name="dietary" rows="2" placeholder="Any allergies or dietary needs..."
              class="w-full border-b border-navy/20 bg-transparent text-navy font-serif font-light text-sm pb-2 pt-1 focus:outline-none focus:border-navy/60 transition-colors placeholder:text-navy/20 resize-none"></textarea>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block font-sans text-[0.6rem] tracking-[0.25em] uppercase text-navy/60 mb-2">
              Message <span class="text-navy/30 normal-case tracking-normal font-sans text-[0.6rem]">(optional)</span>
            </label>
            <textarea id="message" name="message" rows="3" placeholder="Share a message for JBen & JCaitlin..."
              class="w-full border-b border-navy/20 bg-transparent text-navy font-serif font-light text-sm pb-2 pt-1 focus:outline-none focus:border-navy/60 transition-colors placeholder:text-navy/20 resize-none"></textarea>
          </div>

          <!-- Submit -->
          <div class="pt-4 text-center">
            <button type="submit" class="btn-primary cursor-pointer w-full sm:w-auto">Send RSVP</button>
          </div>
        </div>
      </form>

      <!-- Success -->
      <div id="success-message" class="hidden text-center py-20">
        <p class="font-script text-5xl text-navy mb-4">Thank you!</p>
        <div class="divider-gold max-w-[120px] mx-auto"></div>
        <p class="font-serif font-light text-navy/60 text-sm mt-4">We've received your RSVP and can't wait to celebrate with you in Bermuda.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .divider-gold {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem auto;
  }
  .divider-gold::before,
  .divider-gold::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #A8874A;
    opacity: 0.4;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const preselect = params.get('event');
  if (preselect) {
    const checkbox = document.querySelector(`input[name="events"][value="${preselect}"]`) as HTMLInputElement;
    if (checkbox) checkbox.checked = true;
  }
  if (params.get('success') === 'true') {
    document.getElementById('rsvp-form')?.classList.add('hidden');
    document.getElementById('success-message')?.classList.remove('hidden');
  }
</script>
